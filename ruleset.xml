<?xml version="1.0"?>
<ruleset name="Theme PHP Compatibility">
  <description>Checkt PHP-Kompatibilität und WordPress Standards.</description>

  <!-- PHP-Kompatibilität für WordPress-Umfeld -->
  <rule ref="PHPCompatibilityWP"/>

  <!-- Optional: WordPress-Coding-Standards -->
  <rule ref="WordPress"/>
  <rule ref="WordPress-Docs"/>

  <!-- Ziel-PHP-Spanne -->
  <config name="testVersion" value="7.4-8.3"/>

  <!-- Was wird gescannt -->
  <file>./</file>

  <!-- Ausnahmen -->
  <exclude-pattern>vendor/*</exclude-pattern>
  <exclude-pattern>node_modules/*</exclude-pattern>
  <exclude-pattern>.github/*</exclude-pattern>
</ruleset>
